{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/scope-d-reference-framework.schema.json",
  "title": "SCOPE-D Reference Framework Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "generatedFor", "references"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "catalogId": { "type": "string", "pattern": "^reference-catalog-[a-z0-9][a-z0-9._:-]*$" },
    "generatedFor": { "type": "string", "const": "SCOPE-D" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "category", "adoptionMode", "safetyClass", "capabilityTargets", "doNotImport", "nextActions"],
        "properties": {
          "id": { "type": "string", "pattern": "^ref-[a-z0-9][a-z0-9._:-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "category": {
            "type": "string",
            "enum": [
              "agentic_cloud_purple_team",
              "purple_team_methodology",
              "atomic_validation",
              "threat_intel",
              "countermeasure_rules",
              "ai_infra_security",
              "graph_robustness",
              "adversary_emulation_taxonomy"
            ]
          },
          "adoptionMode": {
            "type": "string",
            "enum": ["direct_reference", "pattern_extract", "taxonomy_only", "contract_mapping", "do_not_import_code"]
          },
          "safetyClass": {
            "type": "string",
            "enum": ["safe_defensive", "dual_use_restricted", "taxonomy_only", "research_only"]
          },
          "capabilityTargets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "control_loop",
                "exercise_model",
                "atomic_tests",
                "threat_intel_feeds",
                "countermeasure_packaging",
                "ai_infra_assessment",
                "mcp_tool_risk",
                "agent_skill_risk",
                "graph_robustness",
                "synthetic_events",
                "dashboard_handoff",
                "policy_gates",
                "run_receipts"
              ]
            }
          },
          "lessons": { "type": "array", "items": { "type": "string" } },
          "doNotImport": { "type": "array", "items": { "type": "string" } },
          "nextActions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
