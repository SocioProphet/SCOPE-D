{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-meshrush-graph-view-export.schema.json",
  "title": "Wargames MeshRush Graph View Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportId",
    "graphViewId",
    "mode",
    "sourceRunRefs",
    "topicRefs",
    "boundaryEventRefs",
    "evidenceRefs",
    "proofRefs",
    "nodeRefs",
    "edgeRefs",
    "validationState",
    "redactionState",
    "nonClaims",
    "rawIdentityJoinsAllowed",
    "runtimeConnectionEstablished",
    "traversalAuthority",
    "mutationAuthority"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "exportId": { "type": "string", "pattern": "^meshrush-export:[a-z0-9][a-z0-9._:-]*$" },
    "graphViewId": { "type": "string", "pattern": "^graph-view:[a-z0-9][a-z0-9._:-]*$" },
    "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING"] },
    "sourceRunRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^wargames-[a-z0-9][a-z0-9._:-]*$" } },
    "topicRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "boundaryEventRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^boundary-event:[a-z0-9][a-z0-9._:-]*$" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(evidence|negative-evidence):[a-z0-9][a-z0-9._:-]*$" } },
    "proofRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "nodeRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "edgeRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "motifRefs": { "type": "array", "items": { "type": "string" } },
    "validationState": { "type": "string", "enum": ["validated", "needs_review", "invalid"] },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "nonClaims": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "rawIdentityJoinsAllowed": { "type": "boolean", "const": false },
    "runtimeConnectionEstablished": { "type": "boolean", "const": false },
    "traversalAuthority": { "type": "boolean", "const": false },
    "mutationAuthority": { "type": "boolean", "const": false }
  }
}
