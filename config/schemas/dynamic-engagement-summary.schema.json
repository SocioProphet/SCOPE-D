{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/dynamic-engagement-summary.schema.json",
  "title": "Dynamic Engagement Summary",
  "description": "A governed rolling summary of engagement state within a wargames operation. Does not constitute an authorization or execution directive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summaryId",
    "engagementAuthorizationRef",
    "summaryWindow",
    "actionRefs",
    "evidenceRefs",
    "openItems",
    "runtimeAuthority",
    "executionAllowed",
    "redactionState",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "summaryId": { "type": "string", "pattern": "^dynamic-engagement-summary:[a-z0-9][a-z0-9._:-]*$" },
    "engagementAuthorizationRef": { "type": "string", "pattern": "^engagement-authorization:[a-z0-9][a-z0-9._:-]*$" },
    "summaryWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "actionRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "openItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "description", "severity"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "assignedTo": { "type": "string" }
        }
      }
    },
    "runtimeAuthority": { "type": "boolean", "const": false },
    "executionAllowed": { "type": "boolean", "const": false },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
