{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/scope-d-run-receipt.schema.json",
  "title": "SCOPE-D Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "runId", "status", "artifactHashes", "policyDecisions", "safetySummary", "issuedAt"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^receipt-[a-z0-9][a-z0-9._:-]*$" },
    "runId": { "type": "string" },
    "status": { "type": "string", "enum": ["partial", "blocked", "failed", "completed"] },
    "artifactHashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "policyDecisions": { "type": "array", "items": { "type": "string" } },
    "safetySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "liveActionsExecuted", "destructiveActionsBlocked"],
      "properties": {
        "mode": { "type": "string", "enum": ["read_only", "synthetic_only", "dry_run", "write_with_gate", "blocked"] },
        "liveActionsExecuted": { "type": "integer", "minimum": 0 },
        "destructiveActionsBlocked": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string" },
        "keyId": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
