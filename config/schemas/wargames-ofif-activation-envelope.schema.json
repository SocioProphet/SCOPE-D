{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-ofif-activation-envelope.schema.json",
  "title": "Wargames OFIF Activation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "envelopeId",
    "deliveryClass",
    "topicRefs",
    "evidenceRefs",
    "scoutProofRef",
    "synapseiqEnrichmentRef",
    "ofifFormatVersion",
    "outputIntelligenceSummaryRef",
    "nonClaims",
    "redactionState",
    "disclosureClass",
    "clientScope",
    "tenantScope",
    "proofRefs",
    "sourceRunRefs",
    "rawIdentityJoinsAllowed",
    "runtimeAuthority",
    "liveDeliveryExecuted"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "envelopeId": { "type": "string", "pattern": "^ofif-activation:[a-z0-9][a-z0-9._:-]*$" },
    "deliveryClass": { "type": "string", "enum": ["advisory", "situational_update", "engagement_ready", "post_engagement_assessment"] },
    "topicRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(evidence|negative-evidence):[a-z0-9][a-z0-9._:-]*$" } },
    "scoutProofRef": { "type": "string", "pattern": "^proof:scout:[a-z0-9][a-z0-9._:-]*$" },
    "engagementAuthorizationRef": { "type": "string", "pattern": "^engagement-authorization:[a-z0-9][a-z0-9._:-]*$" },
    "synapseiqEnrichmentRef": { "type": "string", "pattern": "^synapseiq-enrichment:[a-z0-9][a-z0-9._:-]*$" },
    "ofifFormatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "outputIntelligenceSummaryRef": { "type": "string", "minLength": 1 },
    "nonClaims": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "disclosureClass": { "type": "string", "enum": ["internal", "client", "auditor", "public_redacted"] },
    "clientScope": { "type": "string", "minLength": 1 },
    "tenantScope": { "type": "string", "minLength": 1 },
    "proofRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sourceRunRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^wargames-[a-z0-9][a-z0-9._:-]*$" } },
    "rawIdentityJoinsAllowed": { "type": "boolean", "const": false },
    "runtimeAuthority": { "type": "boolean", "const": false },
    "liveDeliveryExecuted": { "type": "boolean", "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "deliveryClass": { "const": "engagement_ready" } }, "required": ["deliveryClass"] },
      "then": { "required": ["engagementAuthorizationRef"] }
    }
  ]
}
