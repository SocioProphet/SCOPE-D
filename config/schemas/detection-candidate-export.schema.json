{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.dev/scope-d/detection-candidate-export.schema.json",
  "title": "SCOPE-D Detection Candidate Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportId", "generatedAt", "sourceEnrichmentRef", "ruleFamilies", "candidates", "cloudshellFog", "whiteRabbitNeoWorkflow", "executionPerformed"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "exportId": { "type": "string", "pattern": "^detection-candidate-export:[a-z0-9][a-z0-9._:-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceEnrichmentRef": { "type": "string", "minLength": 1 },
    "ruleFamilies": { "type": "array", "minItems": 1, "items": { "enum": ["sigma", "yara", "osquery", "opa_rego", "suricata", "github_policy", "sourceos_policy"] } },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "family", "title", "description", "exploitScenario", "severity", "status", "sourceObservationRef", "sourceEvidenceRefs", "attackMappings", "ruleBody", "deployment", "provenance"],
        "properties": {
          "candidateId": { "type": "string", "pattern": "^detection-candidate:[a-z0-9][a-z0-9._:-]*$" },
          "family": { "enum": ["sigma", "yara", "osquery", "opa_rego", "suricata", "github_policy", "sourceos_policy"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "exploitScenario": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "status": { "enum": ["candidate", "needs_review", "approved_for_lab", "deprecated"] },
          "sourceObservationRef": { "type": "string", "pattern": "^intelligence-observation:[a-z0-9][a-z0-9._:-]*$" },
          "sourceEvidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "attackMappings": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ATT&CK:T[0-9]{4}(\\.[0-9]{3})?$" } },
          "ruleBody": { "type": "string", "minLength": 1 },
          "deployment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "cloudshellFogEligible", "requiresOperatorApproval", "executionAllowed", "executionPerformed"],
            "properties": {
              "target": { "enum": ["local_lab", "cloudshell_fog", "soc_pipeline", "sourceos_policyfabric", "manual_review"] },
              "cloudshellFogEligible": { "type": "boolean" },
              "requiresOperatorApproval": { "const": true },
              "executionAllowed": { "const": false },
              "executionPerformed": { "const": false }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generatedBy", "modelAssistance", "grounding", "confidence"],
            "properties": {
              "generatedBy": { "const": "scope-d-arsenal-v0.1" },
              "modelAssistance": { "enum": ["none", "whiterabbitneo_defensive_review"] },
              "grounding": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "confidence": { "type": "number", "minimum": 0.7, "maximum": 1 }
            }
          }
        }
      }
    },
    "cloudshellFog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "allowedModes", "prohibitedModes", "deliveryState"],
      "properties": {
        "role": { "const": "authorized_edge_operator_bastion" },
        "allowedModes": { "type": "array", "minItems": 1, "items": { "enum": ["lab_review", "read_only_observation", "policy_gated_delivery", "mesh_edge_assurance"] } },
        "prohibitedModes": { "type": "array", "minItems": 1, "items": { "enum": ["unauthorized_access", "stealth_persistence", "payload_execution", "credential_collection", "log_mutation", "public_scanning"] } },
        "deliveryState": { "const": "candidate_only_requires_operator_approval" }
      }
    },
    "whiteRabbitNeoWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "allowedUse", "blockedUse", "requiresGrounding"],
      "properties": {
        "role": { "const": "defensive_detection_review_assistant" },
        "allowedUse": { "type": "array", "minItems": 1, "items": { "enum": ["rule_explanation", "false_positive_review", "coverage_gap_review", "safe_lab_detection_triage"] } },
        "blockedUse": { "type": "array", "minItems": 1, "items": { "enum": ["payload_creation", "evasion_guidance", "credential_theft", "unauthorized_exploitation", "destructive_action"] } },
        "requiresGrounding": { "const": true }
      }
    },
    "executionPerformed": { "const": false }
  }
}
