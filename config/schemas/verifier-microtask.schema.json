{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/verifier-microtask.schema.json",
  "title": "Verifier Microtask",
  "description": "A governed microtask issued to a verifier agent for HPST evaluation. The task describes work to be done; execution requires separate authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "microtaskId",
    "probeRef",
    "verifierRef",
    "taskState",
    "executionAllowed",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "microtaskId": { "type": "string", "pattern": "^verifier-microtask:[a-z0-9][a-z0-9._:-]*$" },
    "probeRef": { "type": "string", "pattern": "^hpst-probe:[a-z0-9][a-z0-9._:-]*$" },
    "verifierRef": { "type": "string", "minLength": 1 },
    "taskState": {
      "type": "string",
      "enum": ["proposed", "assigned", "in_progress", "completed", "blocked", "cancelled"]
    },
    "executionAllowed": { "type": "boolean", "const": false },
    "resultRef": { "type": "string" },
    "rewardReceiptRef": { "type": "string" },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
