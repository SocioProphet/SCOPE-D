{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/operator-live-readonly-request.schema.json",
  "title": "SCOPE-D Operator Live Read-Only Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "operatorId",
    "policyRef",
    "targetRef",
    "surfaceKind",
    "readMethod",
    "requestedAt",
    "liveConnectionRequested",
    "toolInvocationRequested",
    "promptExecutionRequested",
    "mutationRequested",
    "credentialAccessRequested"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "requestId": { "type": "string", "pattern": "^operator-live-readonly-request:[a-z0-9][a-z0-9._:-]*$" },
    "operatorId": { "type": "string", "minLength": 1 },
    "policyRef": { "type": "string", "minLength": 1 },
    "targetRef": { "type": "string", "minLength": 1 },
    "surfaceKind": { "type": "string", "enum": ["mcp_discovery", "github_posture", "k8s_manifest", "ai_runtime"] },
    "readMethod": { "type": "string", "enum": ["mcp_tools_list", "github_repo_metadata", "github_branch_protection", "github_actions_permissions", "github_codeowners", "github_environments", "github_security_features", "local_manifest_file_read", "ai_runtime_manifest_read"] },
    "requestedAt": { "type": "string", "format": "date-time" },
    "liveConnectionRequested": { "type": "boolean" },
    "toolInvocationRequested": { "type": "boolean", "const": false },
    "promptExecutionRequested": { "type": "boolean", "const": false },
    "mutationRequested": { "type": "boolean", "const": false },
    "credentialAccessRequested": { "type": "boolean", "const": false }
  }
}
