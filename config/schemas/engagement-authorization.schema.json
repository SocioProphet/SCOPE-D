{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/engagement-authorization.schema.json",
  "title": "Wargames Engagement Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationId",
    "engagementLevel",
    "requestedBy",
    "approvedBy",
    "approvalStatus",
    "tenantScope",
    "allowedAssets",
    "allowedActions",
    "prohibitedActions",
    "timeWindow",
    "evidenceRequirements",
    "rollbackPlanRef",
    "notificationPlanRef",
    "proofReceiptRef",
    "expiry"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "authorizationId": { "type": "string", "pattern": "^engagement-authorization:[a-z0-9][a-z0-9._:-]*$" },
    "engagementLevel": { "type": "string", "enum": ["E4", "E5", "E6"] },
    "requestedBy": { "type": "string", "minLength": 1 },
    "approvedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approvalStatus": { "type": "string", "enum": ["proposed", "approved", "denied", "expired", "revoked"] },
    "tenantScope": { "type": "string", "minLength": 1 },
    "allowedAssets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "evidenceRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollbackPlanRef": { "type": "string", "minLength": 1 },
    "notificationPlanRef": { "type": "string", "minLength": 1 },
    "proofReceiptRef": { "type": "string", "minLength": 1 },
    "expiry": { "type": "string", "format": "date-time" },
    "delegatedPolicyRef": { "type": "string" },
    "michaelOnlyRequired": { "type": "boolean", "const": true }
  }
}
