{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/hpst-probe-set.schema.json",
  "title": "HPST Probe Set",
  "description": "A governed set of semantic probes for HPST evaluation. Probes are proposed; execution requires separate authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "probeSetId",
    "basisRef",
    "probes",
    "executionAllowed",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "probeSetId": { "type": "string", "pattern": "^hpst-probe-set:[a-z0-9][a-z0-9._:-]*$" },
    "basisRef": { "type": "string", "pattern": "^hpst-basis:[a-z0-9][a-z0-9._:-]*$" },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probeId", "dimension", "prompt", "expectedBehavior"],
        "properties": {
          "probeId": { "type": "string", "pattern": "^hpst-probe:[a-z0-9][a-z0-9._:-]*$" },
          "dimension": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "expectedBehavior": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "executionAllowed": { "type": "boolean", "const": false },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
