{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/secret-exposure-policy.schema.json",
  "title": "SCOPE-D Secret Exposure Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "operatorId",
    "approvalRef",
    "allowedSourceRefs",
    "allowedFileExtensions",
    "maxBytesPerFile",
    "redactionRequired",
    "hashingRequired",
    "plaintextExportAllowed",
    "credentialUseAllowed",
    "createdAt",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "policyId": { "type": "string", "pattern": "^secret-exposure-policy:[a-z0-9][a-z0-9._:-]*$" },
    "operatorId": { "type": "string", "minLength": 1 },
    "approvalRef": { "type": "string", "pattern": "^approval:[a-z0-9][a-z0-9._:-]*$" },
    "allowedSourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedFileExtensions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" } },
    "maxBytesPerFile": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "redactionRequired": { "type": "boolean", "const": true },
    "hashingRequired": { "type": "boolean", "const": true },
    "plaintextExportAllowed": { "type": "boolean", "const": false },
    "credentialUseAllowed": { "type": "boolean", "const": false },
    "createdAt": { "type": "string", "format": "date-time" },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
