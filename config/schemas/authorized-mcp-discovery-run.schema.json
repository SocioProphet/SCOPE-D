{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/authorized-mcp-discovery-run.schema.json",
  "title": "SCOPE-D Authorized MCP Discovery Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "requestRef",
    "policyRef",
    "decisionRef",
    "decision",
    "discoverySourceRef",
    "surfaceManifestRef",
    "surfaceRunIndexRef",
    "surfaceAssessmentRef",
    "riskRecordsRef",
    "createdAt",
    "liveConnectionUsed",
    "executionAllowed",
    "executionPerformed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "runId": { "type": "string", "pattern": "^authorized-mcp-discovery-run:[a-z0-9][a-z0-9._:-]*$" },
    "requestRef": { "type": "string", "minLength": 1 },
    "policyRef": { "type": "string", "minLength": 1 },
    "decisionRef": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "enum": ["allow", "hard_block"] },
    "discoverySourceRef": { "type": "string", "minLength": 1 },
    "surfaceManifestRef": { "type": "string", "minLength": 1 },
    "surfaceRunIndexRef": { "type": "string", "minLength": 1 },
    "surfaceAssessmentRef": { "type": "string", "minLength": 1 },
    "riskRecordsRef": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "liveConnectionUsed": { "type": "boolean" },
    "executionAllowed": { "type": "boolean", "const": false },
    "executionPerformed": { "type": "boolean", "const": false }
  }
}
