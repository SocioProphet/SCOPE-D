{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/boundary-event.schema.json",
  "title": "Wargames Boundary Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "time",
    "componentRef",
    "portRef",
    "contractRef",
    "surface",
    "action",
    "result",
    "boundaryScope",
    "topicRefs",
    "evidenceRefs",
    "redactionState",
    "safetyBoundaryRef"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "eventId": { "type": "string", "pattern": "^boundary-event:[a-z0-9][a-z0-9._:-]*$" },
    "time": { "type": "string", "format": "date-time" },
    "componentRef": { "type": "string", "minLength": 1 },
    "portRef": { "type": "string", "minLength": 1 },
    "contractRef": { "type": "string", "minLength": 1 },
    "outsideRef": { "type": "string" },
    "surface": { "type": "string", "enum": ["network", "identity", "execution", "storage", "ui", "content", "control", "ontology", "client"] },
    "action": { "type": "string", "enum": ["dns_query", "connect", "request", "response", "authenticate", "token_issue", "token_use", "file_read", "file_write", "module_load", "config_change", "document_open", "font_load", "canvas_render", "sensor_access", "public_index_observed", "policy_evaluated", "proof_emitted"] },
    "result": { "type": "string", "enum": ["success", "fail", "denied", "observed", "missing", "unknown"] },
    "boundaryScope": { "type": "string", "enum": ["inside", "outside", "mixed", "unknown"] },
    "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING"] },
    "topicRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "phaseRefs": { "type": "array", "items": { "type": "string", "enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7"] } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifactRefs": { "type": "array", "items": { "type": "string" } },
    "findingRefs": { "type": "array", "items": { "type": "string" } },
    "redactionState": { "type": "string", "enum": ["raw", "redacted", "synthetic", "withheld"] },
    "safetyBoundaryRef": { "type": "string", "minLength": 1 },
    "authorizationRef": { "type": "string" },
    "tenantScope": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "completenessScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "attackRefs": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
  }
}
