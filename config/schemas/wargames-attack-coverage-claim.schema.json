{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-attack-coverage-claim.schema.json",
  "title": "Wargames ATT&CK Coverage Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claimId",
    "mode",
    "topicRefs",
    "coverageStatus",
    "tacticRefs",
    "techniqueRefs",
    "evidenceRefs",
    "boundaryEventRefs",
    "controlRefs",
    "proofRefs",
    "semanticNonClaims",
    "redactionState",
    "runtimeAuthority",
    "procedureExecutionAuthority",
    "engagementAuthorizationAuthority"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "claimId": { "type": "string", "pattern": "^attack-coverage:[a-z0-9][a-z0-9._:-]*$" },
    "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING"] },
    "topicRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "coverageStatus": { "type": "string", "enum": ["covered", "partial", "gap", "unknown"] },
    "tacticRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "techniqueRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(evidence|negative-evidence):[a-z0-9][a-z0-9._:-]*$" } },
    "boundaryEventRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^boundary-event:[a-z0-9][a-z0-9._:-]*$" } },
    "controlRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "proofRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "semanticNonClaims": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "confidenceClass": { "type": "string", "enum": ["low", "medium", "high", "not_assessed"] },
    "runtimeAuthority": { "type": "boolean", "const": false },
    "procedureExecutionAuthority": { "type": "boolean", "const": false },
    "engagementAuthorizationAuthority": { "type": "boolean", "const": false }
  }
}
