{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.dev/scope-d/cyber-graph-export.schema.json",
  "title": "SCOPE-D Cyber Graph Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphExportId", "generatedAt", "sourceRefs", "nodes", "edges", "exports", "executionPerformed"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "graphExportId": { "type": "string", "pattern": "^cyber-graph-export:[a-z0-9][a-z0-9._:-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "kind", "label", "sourceRefs", "confidence", "provenanceHash"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["indicator", "provider", "observation", "evidence_receipt", "detection_candidate", "rule_family", "attack_technique", "deployment_target", "agent_workflow", "edge_bastion"] },
          "label": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "provenanceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "from", "predicate", "to", "sourceRefs", "confidence"],
        "properties": {
          "edgeId": { "type": "string", "pattern": "^cyber-graph-runtime-edge:[a-z0-9][a-z0-9._:-]*$" },
          "from": { "type": "string", "minLength": 1 },
          "predicate": { "enum": ["enriched_by", "produced_receipt", "produced_observation", "generated_candidate", "maps_to_attack", "uses_rule_family", "targets_deployment", "reviewed_by_workflow", "eligible_for_edge_bastion", "grounded_in"] },
          "to": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hellgraphStream", "ontogenesisTurtle", "sherlockDocuments", "synapseiqGraphPacket", "noeticaGraphWorkspace"],
      "properties": {
        "hellgraphStream": { "type": "string", "minLength": 1 },
        "ontogenesisTurtle": { "type": "string", "minLength": 1 },
        "sherlockDocuments": { "type": "string", "minLength": 1 },
        "synapseiqGraphPacket": { "type": "string", "minLength": 1 },
        "noeticaGraphWorkspace": { "type": "string", "minLength": 1 }
      }
    },
    "executionPerformed": { "const": false }
  }
}
