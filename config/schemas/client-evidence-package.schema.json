{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/client-evidence-package.schema.json",
  "title": "SCOPE-D Client Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "sourceManifestRef",
    "sourceRunId",
    "clientRef",
    "mode",
    "generatedAt",
    "artifactCount",
    "artifacts",
    "boundaryFlags",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "packageId": { "type": "string", "pattern": "^client-evidence-package:[a-z0-9][a-z0-9._:-]*$" },
    "sourceManifestRef": { "type": "string", "minLength": 1 },
    "sourceRunId": { "type": "string", "minLength": 1 },
    "clientRef": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifactCount": { "type": "integer", "minimum": 1 },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packageArtifact" } },
    "boundaryFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkAccessAttempted", "scanExecutionPerformed", "executionAllowed", "executionPerformed"],
      "properties": {
        "networkAccessAttempted": { "type": "boolean" },
        "scanExecutionPerformed": { "type": "boolean", "const": false },
        "executionAllowed": { "type": "boolean", "const": false },
        "executionPerformed": { "type": "boolean", "const": false }
      }
    },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "packageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "sourcePath", "packagePath", "sha256", "byteLength"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "artifactType": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "packagePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
