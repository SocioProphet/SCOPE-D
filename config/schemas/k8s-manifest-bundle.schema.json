{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/k8s-manifest-bundle.schema.json",
  "title": "SCOPE-D Kubernetes Manifest Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "environment", "namespace", "manifests", "redactionState", "liveClusterAccessUsed", "kubectlExecuted"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "bundleId": { "type": "string", "pattern": "^k8s-manifest-bundle:[a-z0-9][a-z0-9._:-]*$" },
    "environment": { "type": "string", "enum": ["lab", "dev", "staging", "production", "unknown"] },
    "namespace": { "type": "string", "minLength": 1 },
    "manifests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/k8sObject" } },
    "redactionState": { "type": "string", "enum": ["synthetic", "redacted", "withheld"] },
    "liveClusterAccessUsed": { "type": "boolean", "const": false },
    "kubectlExecuted": { "type": "boolean", "const": false }
  },
  "$defs": {
    "k8sObject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["apiVersion", "kind", "metadata"],
      "properties": {
        "apiVersion": { "type": "string" },
        "kind": { "type": "string" },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "spec": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
