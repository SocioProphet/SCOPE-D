{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/font-detector-thresholds.schema.json",
  "title": "Font Detector Thresholds",
  "description": "Configuration thresholds for the OFIF font surface detector. Adjusting these thresholds requires governance review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "thresholdsId",
    "signalThresholds",
    "minimumConfidence",
    "executionAllowed",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "thresholdsId": { "type": "string", "pattern": "^font-detector-thresholds:[a-z0-9][a-z0-9._:-]*$" },
    "signalThresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signalType", "threshold"],
        "properties": {
          "signalType": { "type": "string", "minLength": 1 },
          "threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "notes": { "type": "string" }
        }
      }
    },
    "minimumConfidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "executionAllowed": { "type": "boolean", "const": false },
    "authorityEnvelopeRef": { "type": "string" },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
