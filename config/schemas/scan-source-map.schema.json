{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/scan-source-map.schema.json",
  "title": "SCOPE-D Scan Source Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceMapId", "sources"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "sourceMapId": { "type": "string", "pattern": "^scan-source-map:[a-z0-9][a-z0-9._:-]*$" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "sourceRef"],
      "properties": {
        "targetRef": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
