{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-commander-dashboard.schema.json",
  "title": "Wargames Commander Dashboard Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dashboardId",
    "generatedAt",
    "sourceRunRefs",
    "wargamesMode",
    "surfaceCoverage",
    "phaseState",
    "agentStatus",
    "proofStatus",
    "boundaryEventFindings",
    "tliRwi",
    "engagementLadderState",
    "michaelApprovalStatus",
    "lsaTopicCoverage",
    "ontologyValidation",
    "ofifReadiness",
    "executionPerformed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "dashboardId": {
      "type": "string",
      "pattern": "^wargames-dashboard:[a-z0-9][a-z0-9._:-]*$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRunRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "wargamesMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "activeTopics", "bridgeModeEligible"],
      "properties": {
        "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING", "UNSET"] },
        "activeTopics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "bridgeModeEligible": { "type": "boolean" }
      }
    },
    "surfaceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces"],
      "properties": {
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surfaceId", "coverageClass", "lastObservedAt", "proofRefs"],
            "properties": {
              "surfaceId": { "type": "string", "minLength": 1 },
              "coverageClass": { "type": "string", "enum": ["H1", "H2", "H3", "H4", "H5", "H6", "H7"] },
              "lastObservedAt": { "type": "string", "format": "date-time" },
              "proofRefs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "phaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases"],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phaseId", "stateClass", "validatedAt", "proofRefs"],
            "properties": {
              "phaseId": { "type": "string", "minLength": 1 },
              "stateClass": { "type": "string", "enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7"] },
              "validatedAt": { "type": "string", "format": "date-time" },
              "proofRefs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "agentStatus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "role", "status"],
        "properties": {
          "agentId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "lastActiveAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["active", "standby", "retired", "undeployed"] }
        }
      }
    },
    "proofStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalProofs", "verifiedProofs", "pendingProofs", "proofRefs"],
      "properties": {
        "totalProofs": { "type": "integer", "minimum": 0 },
        "verifiedProofs": { "type": "integer", "minimum": 0 },
        "pendingProofs": { "type": "integer", "minimum": 0 },
        "proofRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "boundaryEventFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "severity", "summary", "evidenceRefs"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tliRwi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tli", "rwi", "rationale"],
      "properties": {
        "tli": { "type": "number", "minimum": 0, "maximum": 1 },
        "rwi": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "engagementLadderState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentLevel", "approvalStatus"],
      "properties": {
        "currentLevel": { "type": "string", "enum": ["E1", "E2", "E3", "E4", "E5", "E6"] },
        "authorizationRef": { "type": "string", "minLength": 1 },
        "approvalStatus": { "type": "string", "enum": ["none", "proposed", "approved", "denied", "expired"] }
      }
    },
    "michaelApprovalStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "approvedActions"],
      "properties": {
        "required": { "type": "boolean" },
        "approvalRef": { "type": "string", "minLength": 1 },
        "approvedActions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lsaTopicCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalTopics", "proofProducingTopics", "capturedDesignTopics", "uncoveredTopics"],
      "properties": {
        "totalTopics": { "type": "integer", "const": 23 },
        "proofProducingTopics": { "type": "integer", "minimum": 0 },
        "capturedDesignTopics": { "type": "integer", "minimum": 0 },
        "uncoveredTopics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ontologyValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationRef", "status"],
      "properties": {
        "validationRef": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["validated", "pending", "failed", "skipped"] },
        "validatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ofifReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientOutputsReady", "pendingDisclosureReviews", "activeEnvelopes"],
      "properties": {
        "clientOutputsReady": { "type": "boolean" },
        "pendingDisclosureReviews": { "type": "integer", "minimum": 0 },
        "activeEnvelopes": { "type": "integer", "minimum": 0 }
      }
    },
    "executionPerformed": { "type": "boolean", "const": false }
  }
}
