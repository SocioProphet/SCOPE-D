{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/scout-profile-proof.schema.json",
  "title": "Scout Profile Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proofId",
    "sweepId",
    "agentRef",
    "mode",
    "surfaces",
    "window",
    "inputs",
    "metrics",
    "anchors",
    "safety",
    "redactionState",
    "proofRefs"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "proofId": { "type": "string", "pattern": "^proof:scout:[a-z0-9][a-z0-9._:-]*$" },
    "sweepId": { "type": "string", "minLength": 1 },
    "agentRef": { "type": "string", "const": "agent:scout" },
    "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING"] },
    "surfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["H1", "H2", "H3", "H4", "H5", "H6", "H7"] } },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaRef", "hashes"],
      "properties": {
        "schemaRef": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "type": "string" } },
        "hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "type": "string", "enum": ["sha256"] },
              "value": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flows", "omega", "schemaValidPct", "coveragePct"],
      "properties": {
        "flows": { "type": "integer", "minimum": 0 },
        "omega": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hi", "med", "lo"],
          "properties": {
            "hi": { "type": "integer", "minimum": 0 },
            "med": { "type": "integer", "minimum": 0 },
            "lo": { "type": "integer", "minimum": 0 }
          }
        },
        "schemaValidPct": { "type": "number", "minimum": 0, "maximum": 1 },
        "coveragePct": { "type": "number", "minimum": 0, "maximum": 1 },
        "privacyAxis": { "type": "number", "minimum": 0, "maximum": 1 },
        "cpuPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "dailyBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lsaDims", "lsi"],
      "properties": {
        "lsaDims": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^L([1-9]|10)$" } },
        "lsi": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["p2", "p3", "p5", "p7", "p11", "p13", "p17", "p19", "p23", "p29", "p31"] } }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safetyBoundaryRef", "payloadBodiesCaptured", "credentialCollectionAllowed", "publicNetworkScanningAllowed"],
      "properties": {
        "safetyBoundaryRef": { "type": "string", "minLength": 1 },
        "payloadBodiesCaptured": { "type": "boolean", "const": false },
        "credentialCollectionAllowed": { "type": "boolean", "const": false },
        "publicNetworkScanningAllowed": { "type": "boolean", "const": false },
        "authorizationRef": { "type": "string" }
      }
    },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "proofRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "signatures": { "type": "array", "items": { "type": "string" } }
  }
}
