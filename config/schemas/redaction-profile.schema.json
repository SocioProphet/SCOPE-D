{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/redaction-profile.schema.json",
  "title": "SCOPE-D Redaction Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileClass",
    "redactionRules",
    "withheldArtifactTypes",
    "createdAt",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "profileId": { "type": "string", "pattern": "^redaction-profile:[a-z0-9][a-z0-9._:-]*$" },
    "profileClass": { "type": "string", "enum": ["internal_full", "client_safe", "public_summary", "withheld_sensitive"] },
    "redactionRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "withheldArtifactTypes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "match", "replacement"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^redaction-rule:[a-z0-9][a-z0-9._:-]*$" },
        "match": { "type": "string", "enum": ["authorization_headers", "cookies", "tokens", "private_ips", "internal_hostnames", "raw_banners", "secret_like_values"] },
        "replacement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
