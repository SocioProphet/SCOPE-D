{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/operator-scan-assurance-run.schema.json",
  "title": "SCOPE-D Operator Scan Assurance Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "clientRef",
    "policyRef",
    "requestRef",
    "planRef",
    "scanResultRef",
    "scanAssessmentRef",
    "surfaceRunIndexRef",
    "operatorWorkflowRef",
    "operatorWorkordersRef",
    "caseIndexRef",
    "dashboardRef",
    "clientReportRef",
    "createdAt",
    "networkAccessAttempted",
    "scanExecutionPerformed",
    "executionAllowed",
    "executionPerformed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "runId": { "type": "string", "pattern": "^operator-scan-assurance-run:[a-z0-9][a-z0-9._:-]*$" },
    "clientRef": { "type": "string", "minLength": 1 },
    "policyRef": { "type": "string", "minLength": 1 },
    "requestRef": { "type": "string", "minLength": 1 },
    "planRef": { "type": "string", "minLength": 1 },
    "scanResultRef": { "type": "string", "minLength": 1 },
    "scanAssessmentRef": { "type": "string", "minLength": 1 },
    "surfaceRunIndexRef": { "type": "string", "minLength": 1 },
    "operatorWorkflowRef": { "type": "string", "minLength": 1 },
    "operatorWorkordersRef": { "type": "string", "minLength": 1 },
    "caseIndexRef": { "type": "string", "minLength": 1 },
    "dashboardRef": { "type": "string", "minLength": 1 },
    "clientReportRef": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "networkAccessAttempted": { "type": "boolean", "const": false },
    "scanExecutionPerformed": { "type": "boolean", "const": false },
    "executionAllowed": { "type": "boolean", "const": false },
    "executionPerformed": { "type": "boolean", "const": false }
  }
}
