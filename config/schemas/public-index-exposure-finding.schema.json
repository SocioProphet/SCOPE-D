{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/public-index-exposure-finding.schema.json",
  "title": "Public Index Exposure Finding",
  "description": "A governed finding produced by a public index exposure query. Does not authorize client delivery or remediation execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "findingId",
    "queryRef",
    "exposureType",
    "severity",
    "evidenceRefs",
    "redactionState",
    "remediationAllowed",
    "executionAllowed",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "findingId": { "type": "string", "pattern": "^public-index-finding:[a-z0-9][a-z0-9._:-]*$" },
    "queryRef": { "type": "string", "pattern": "^public-index-query:[a-z0-9][a-z0-9._:-]*$" },
    "exposureType": {
      "type": "string",
      "enum": ["domain_exposure", "email_exposure", "api_key_exposure", "credential_exposure", "code_exposure", "document_exposure"]
    },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "remediationAllowed": { "type": "boolean" },
    "executionAllowed": { "type": "boolean", "const": false },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
