{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/redacted-evidence-package.schema.json",
  "title": "SCOPE-D Redacted Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "redactedPackageId",
    "sourcePackageRef",
    "redactionProfileRef",
    "clientRef",
    "generatedAt",
    "artifactCount",
    "artifacts",
    "withheldArtifacts",
    "boundaryFlags",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "redactedPackageId": { "type": "string", "pattern": "^redacted-evidence-package:[a-z0-9][a-z0-9._:-]*$" },
    "sourcePackageRef": { "type": "string", "minLength": 1 },
    "redactionProfileRef": { "type": "string", "minLength": 1 },
    "clientRef": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifactCount": { "type": "integer", "minimum": 0 },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "withheldArtifacts": { "type": "array", "items": { "$ref": "#/$defs/withheld" } },
    "boundaryFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkAccessAttempted", "scanExecutionPerformed", "executionAllowed", "executionPerformed"],
      "properties": {
        "networkAccessAttempted": { "type": "boolean" },
        "scanExecutionPerformed": { "type": "boolean", "const": false },
        "executionAllowed": { "type": "boolean", "const": false },
        "executionPerformed": { "type": "boolean", "const": false }
      }
    },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "sourcePackagePath", "redactedPackagePath", "sha256", "byteLength", "redactionApplied"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "artifactType": { "type": "string", "minLength": 1 },
        "sourcePackagePath": { "type": "string", "minLength": 1 },
        "redactedPackagePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "redactionApplied": { "type": "boolean" }
      }
    },
    "withheld": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactType", "reason"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "artifactType": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
