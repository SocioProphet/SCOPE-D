{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/mcp-surface-manifest.schema.json",
  "title": "SCOPE-D MCP Surface Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "serverRef", "serverName", "environment", "transport", "auth", "tools", "redactionState", "liveConnectionUsed"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "manifestId": { "type": "string", "pattern": "^mcp-surface-manifest:[a-z0-9][a-z0-9._:-]*$" },
    "serverRef": { "type": "string", "minLength": 1 },
    "serverName": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["lab", "dev", "staging", "production", "unknown"] },
    "transport": { "type": "string", "enum": ["stdio", "http", "sse", "websocket", "unknown"] },
    "auth": { "type": "object", "additionalProperties": false, "required": ["required", "method"], "properties": { "required": { "type": "boolean" }, "method": { "type": "string", "enum": ["none", "api_key", "oauth", "mTLS", "unknown"] } } },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool" } },
    "redactionState": { "type": "string", "enum": ["synthetic", "redacted", "withheld"] },
    "liveConnectionUsed": { "type": "boolean" }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "description", "permissions", "argumentSchema"],
      "properties": {
        "toolName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "argumentSchema": { "type": "object" },
        "riskHints": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
