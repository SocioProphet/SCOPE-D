{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/agent-gradecard.schema.json",
  "title": "Agent Gradecard",
  "description": "A governed gradecard for an agent evaluated against an HPST probe set. Holding this record does not confer deployment or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gradecardId",
    "agentRef",
    "probeSetRef",
    "evaluationWindow",
    "dimensionScores",
    "overallScore",
    "evidenceRefs",
    "deploymentAllowed",
    "executionAllowed",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "gradecardId": { "type": "string", "pattern": "^agent-gradecard:[a-z0-9][a-z0-9._:-]*$" },
    "agentRef": { "type": "string", "minLength": 1 },
    "probeSetRef": { "type": "string", "pattern": "^hpst-probe-set:[a-z0-9][a-z0-9._:-]*$" },
    "evaluationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "dimensionScores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "score", "probeCount"],
        "properties": {
          "dimension": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "probeCount": { "type": "integer", "minimum": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "overallScore": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "deploymentAllowed": { "type": "boolean" },
    "executionAllowed": { "type": "boolean", "const": false },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
