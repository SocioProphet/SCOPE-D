{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-invocation-envelope.schema.json",
  "title": "Wargames Invocation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invocationId",
    "requestedAt",
    "requestedBy",
    "capabilityClass",
    "mode",
    "surfaceRefs",
    "phaseRefs",
    "topicRefs",
    "sourceRunRefs",
    "evidenceRefs",
    "proofRefs",
    "contractRefs",
    "authorizationRefs",
    "redactionState",
    "tenantScope",
    "requestedAction",
    "runtimeTargetRef",
    "rawIdentityJoinsRequested",
    "payloadBodiesRequested",
    "credentialAccessRequested",
    "publicNetworkAccessRequested",
    "liveExecutionRequested"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "invocationId": { "type": "string", "pattern": "^wargames-invocation:[a-z0-9][a-z0-9._:-]*$" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "requestedBy": { "type": "string", "minLength": 1 },
    "capabilityClass": {
      "type": "string",
      "enum": ["observe_profile", "validate", "export", "enrich", "activate_deliver", "engage", "graph_view", "replay"]
    },
    "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING"] },
    "surfaceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "phaseRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7"] } },
    "topicRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "sourceRunRefs": { "type": "array", "items": { "type": "string", "pattern": "^wargames-[a-z0-9][a-z0-9._:-]*$" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(evidence|negative-evidence):[a-z0-9][a-z0-9._:-]*$" } },
    "proofRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "contractRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authorizationRefs": { "type": "array", "items": { "type": "string", "pattern": "^(engagement-authorization|authorization):[a-z0-9][a-z0-9._:-]*$" } },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld", "raw"] },
    "clientScope": { "type": ["string", "null"] },
    "tenantScope": { "type": "string", "minLength": 1 },
    "requestedAction": { "type": "string", "minLength": 1 },
    "runtimeTargetRef": { "type": ["string", "null"] },
    "rawIdentityJoinsRequested": { "type": "boolean" },
    "payloadBodiesRequested": { "type": "boolean" },
    "credentialAccessRequested": { "type": "boolean" },
    "publicNetworkAccessRequested": { "type": "boolean" },
    "liveExecutionRequested": { "type": "boolean" }
  }
}
