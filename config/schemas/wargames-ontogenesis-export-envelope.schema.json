{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-ontogenesis-export-envelope.schema.json",
  "title": "Wargames Ontogenesis Export Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportId",
    "jsonldContextRef",
    "ontologyModuleRef",
    "mode",
    "topicRefs",
    "sourceRunRefs",
    "coverageClaimRefs",
    "evidenceRefs",
    "proofRefs",
    "redactionState",
    "semanticNonClaims",
    "runtimeAuthority",
    "procedureExecutionAuthority",
    "engagementAuthorizationAuthority",
    "activationAllowed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "exportId": { "type": "string", "pattern": "^ontogenesis-export:[a-z0-9][a-z0-9._:-]*$" },
    "jsonldContextRef": { "type": "string", "minLength": 1 },
    "ontologyModuleRef": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["DEFENSE", "LEARNING"] },
    "topicRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "sourceRunRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^wargames-[a-z0-9][a-z0-9._:-]*$" } },
    "coverageClaimRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^attack-coverage:[a-z0-9][a-z0-9._:-]*$" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(evidence|negative-evidence):[a-z0-9][a-z0-9._:-]*$" } },
    "proofRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "semanticNonClaims": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "shaclValidationRef": { "type": "string" },
    "runtimeAuthority": { "type": "boolean", "const": false },
    "procedureExecutionAuthority": { "type": "boolean", "const": false },
    "engagementAuthorizationAuthority": { "type": "boolean", "const": false },
    "activationAllowed": { "type": "boolean", "const": false }
  }
}
