{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/operator-playbook.schema.json",
  "title": "SCOPE-D Operator Playbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "playbookId",
    "title",
    "surfaceKinds",
    "triggerCategories",
    "requiredEvidence",
    "operatorSteps",
    "recommendedControls",
    "approvalRequired",
    "blockedActions",
    "nonClaims",
    "reassessmentCommand",
    "executionAllowed",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "playbookId": { "type": "string", "pattern": "^operator-playbook:[a-z0-9][a-z0-9._:-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "surfaceKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["github_posture", "mcp_surface", "mcp_discovery", "ai_runtime", "k8s_manifest", "network_boundary", "web_endpoint", "cross_surface"] } },
    "triggerCategories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["surface-run-index", "assessment", "risk-records", "operator-workorder", "operator-triage", "operator-workflow"] } },
    "operatorSteps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/playbookStep" } },
    "recommendedControls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approvalRequired": { "type": "boolean" },
    "blockedActions": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["live_execution", "tool_invocation", "cluster_mutation", "deployment", "credential_access", "external_scan", "model_prompt_execution", "policy_mutation"] } },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reassessmentCommand": { "type": "string", "minLength": 1 },
    "executionAllowed": { "type": "boolean", "const": false },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "playbookStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "title", "instruction", "expectedEvidence", "approvalRequired", "executionAllowed"],
      "properties": {
        "stepId": { "type": "string", "pattern": "^step-[a-z0-9][a-z0-9._:-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "expectedEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "approvalRequired": { "type": "boolean" },
        "executionAllowed": { "type": "boolean", "const": false }
      }
    }
  }
}
