{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/ai-runtime-exposure-assessment.schema.json",
  "title": "SCOPE-D AI Runtime Exposure Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "manifestRef", "runtimeRef", "runtimeName", "environment", "riskScore", "riskLevel", "findings", "recommendedControls", "redactionState", "liveConnectionUsed", "promptExecutionPerformed"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "assessmentId": { "type": "string", "pattern": "^ai-runtime-exposure-assessment:[a-z0-9][a-z0-9._:-]*$" },
    "manifestRef": { "type": "string", "minLength": 1 },
    "runtimeRef": { "type": "string", "minLength": 1 },
    "runtimeName": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["lab", "dev", "staging", "production", "unknown"] },
    "riskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "severity", "evidence", "recommendation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["public_endpoint", "missing_auth", "unscoped_tokens", "tool_binding", "memory_exposure", "prompt_boundary", "logging_exposure", "missing_rate_limit", "tenant_isolation"] },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
          "evidence": { "type": "object", "additionalProperties": true },
          "recommendation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendedControls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "redactionState": { "type": "string", "enum": ["synthetic", "redacted", "withheld"] },
    "liveConnectionUsed": { "type": "boolean", "const": false },
    "promptExecutionPerformed": { "type": "boolean", "const": false }
  }
}
