{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/negative-evidence.schema.json",
  "title": "Wargames Negative Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "expectedRecord",
    "absenceWindow",
    "expectedSources",
    "reason",
    "confidence",
    "redactionState",
    "safetyBoundaryRef"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "evidenceId": { "type": "string", "pattern": "^negative-evidence:[a-z0-9][a-z0-9._:-]*$" },
    "boundaryEventRef": { "type": "string" },
    "expectedRecord": { "type": "string", "minLength": 1 },
    "recordRef": { "type": "null" },
    "absenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "expectedSources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reason": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "safetyBoundaryRef": { "type": "string", "minLength": 1 },
    "findingRefs": { "type": "array", "items": { "type": "string" } },
    "topicRefs": { "type": "array", "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "reviewRequired": { "type": "boolean" }
  }
}
