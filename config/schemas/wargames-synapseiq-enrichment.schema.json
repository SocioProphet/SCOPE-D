{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/wargames-synapseiq-enrichment.schema.json",
  "title": "Wargames SynapseIQ Enrichment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enrichmentId",
    "inputEvidenceRefs",
    "outputIntelligenceSummaryRef",
    "topicClassifications",
    "enrichmentMethod",
    "confidenceClass",
    "enrichmentNonClaims",
    "redactionState",
    "runtimeAuthority",
    "liveLookupPerformed",
    "modelMutationPerformed",
    "engagementDecisionAuthority"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "enrichmentId": { "type": "string", "pattern": "^synapseiq-enrichment:[a-z0-9][a-z0-9._:-]*$" },
    "inputEvidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(evidence|negative-evidence):[a-z0-9][a-z0-9._:-]*$" } },
    "outputIntelligenceSummaryRef": { "type": "string", "minLength": 1 },
    "topicClassifications": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T(0?[1-9]|1[0-9]|2[0-3])$" } },
    "enrichmentMethod": { "type": "string", "enum": ["rules", "ontology_alignment", "semantic_enrichment", "manual_review", "hybrid"] },
    "confidenceClass": { "type": "string", "enum": ["low", "medium", "high", "not_assessed"] },
    "enrichmentNonClaims": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "redactionState": { "type": "string", "enum": ["redacted", "synthetic", "withheld"] },
    "ontologyValidationRef": { "type": "string" },
    "qualityReportRef": { "type": "string" },
    "runtimeAuthority": { "type": "boolean", "const": false },
    "liveLookupPerformed": { "type": "boolean", "const": false },
    "modelMutationPerformed": { "type": "boolean", "const": false },
    "engagementDecisionAuthority": { "type": "boolean", "const": false }
  }
}
