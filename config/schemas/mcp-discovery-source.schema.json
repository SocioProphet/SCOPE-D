{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/mcp-discovery-source.schema.json",
  "title": "SCOPE-D MCP Discovery Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "serverRef", "serverName", "environment", "transport", "auth", "tools", "redactionState", "liveConnectionUsed", "toolExecutionPerformed"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "sourceId": { "type": "string", "pattern": "^mcp-discovery-source:[a-z0-9][a-z0-9._:-]*$" },
    "serverRef": { "type": "string", "minLength": 1 },
    "serverName": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["lab", "dev", "staging", "production", "unknown"] },
    "transport": { "type": "string", "enum": ["stdio", "http", "sse", "websocket", "unknown"] },
    "auth": { "type": "object", "additionalProperties": false, "required": ["required", "method"], "properties": { "required": { "type": "boolean" }, "method": { "type": "string", "enum": ["none", "api_key", "oauth", "mTLS", "unknown"] } } },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/discoveredTool" } },
    "redactionState": { "type": "string", "enum": ["synthetic", "redacted", "withheld"] },
    "liveConnectionUsed": { "type": "boolean" },
    "toolExecutionPerformed": { "type": "boolean", "const": false }
  },
  "$defs": {
    "discoveredTool": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "description", "inputSchema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "annotations": { "type": "object" },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
