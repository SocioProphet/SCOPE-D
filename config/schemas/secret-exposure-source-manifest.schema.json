{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/secret-exposure-source-manifest.schema.json",
  "title": "SCOPE-D Secret Exposure Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceManifestId", "operatorId", "policyRef", "sources", "createdAt"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "sourceManifestId": { "type": "string", "pattern": "^secret-exposure-source-manifest:[a-z0-9][a-z0-9._:-]*$" },
    "operatorId": { "type": "string", "minLength": 1 },
    "policyRef": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "path", "sourceKind"],
      "properties": {
        "sourceRef": { "type": "string", "pattern": "^secret-source:[a-z0-9][a-z0-9._:-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "sourceKind": { "type": "string", "enum": ["supplied_evidence", "synthetic_fixture", "local_repository_snapshot", "client_package_artifact"] }
      }
    }
  }
}
