{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/ai-runtime-exposure-manifest.schema.json",
  "title": "SCOPE-D AI Runtime Exposure Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "runtimeRef", "runtimeName", "environment", "endpoint", "auth", "model", "toolBindings", "memoryStores", "promptBoundary", "logging", "rateLimit", "redactionState", "liveConnectionUsed", "promptExecutionPerformed"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "manifestId": { "type": "string", "pattern": "^ai-runtime-exposure-manifest:[a-z0-9][a-z0-9._:-]*$" },
    "runtimeRef": { "type": "string", "minLength": 1 },
    "runtimeName": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["lab", "dev", "staging", "production", "unknown"] },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposure", "network", "tenantIsolation"],
      "properties": {
        "exposure": { "type": "string", "enum": ["private", "internal", "public", "unknown"] },
        "network": { "type": "string", "enum": ["localhost", "vpc", "cluster", "internet", "unknown"] },
        "tenantIsolation": { "type": "string", "enum": ["single_tenant", "multi_tenant", "none", "unknown"] }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "method", "scopedTokens"],
      "properties": {
        "required": { "type": "boolean" },
        "method": { "type": "string", "enum": ["none", "api_key", "oauth", "mTLS", "jwt", "unknown"] },
        "scopedTokens": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId", "deploymentMode"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "deploymentMode": { "type": "string", "enum": ["hosted", "self_hosted", "local", "unknown"] }
      }
    },
    "toolBindings": { "type": "array", "items": { "$ref": "#/$defs/toolBinding" } },
    "memoryStores": { "type": "array", "items": { "$ref": "#/$defs/memoryStore" } },
    "promptBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemPromptPinned", "toolInstructionIsolation", "retrievalContentDelimited", "outputSchemaEnforced"],
      "properties": {
        "systemPromptPinned": { "type": "boolean" },
        "toolInstructionIsolation": { "type": "boolean" },
        "retrievalContentDelimited": { "type": "boolean" },
        "outputSchemaEnforced": { "type": "boolean" }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storesPrompts", "storesToolOutputs", "redactionRequired", "retentionDays"],
      "properties": {
        "storesPrompts": { "type": "boolean" },
        "storesToolOutputs": { "type": "boolean" },
        "redactionRequired": { "type": "boolean" },
        "retentionDays": { "type": "integer", "minimum": 0 }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requestsPerMinute": { "type": "integer", "minimum": 0 }
      }
    },
    "redactionState": { "type": "string", "enum": ["synthetic", "redacted", "withheld"] },
    "liveConnectionUsed": { "type": "boolean", "const": false },
    "promptExecutionPerformed": { "type": "boolean", "const": false }
  },
  "$defs": {
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "surfaceRef", "permissions", "requiresPolicyGate"],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "surfaceRef": { "type": "string", "minLength": 1 },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "requiresPolicyGate": { "type": "boolean" }
      }
    },
    "memoryStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeId", "storeType", "containsSensitiveData", "writeEnabled", "crossTenantAccessible"],
      "properties": {
        "storeId": { "type": "string", "minLength": 1 },
        "storeType": { "type": "string", "enum": ["vector", "document", "kv", "conversation", "unknown"] },
        "containsSensitiveData": { "type": "boolean" },
        "writeEnabled": { "type": "boolean" },
        "crossTenantAccessible": { "type": "boolean" }
      }
    }
  }
}
