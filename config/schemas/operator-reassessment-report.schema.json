{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/operator-reassessment-report.schema.json",
  "title": "SCOPE-D Operator Reassessment Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "caseRef",
    "previousRunIndexRef",
    "newRunIndexRef",
    "surfaceKind",
    "previousRiskScore",
    "newRiskScore",
    "riskDelta",
    "previousRiskLevel",
    "newRiskLevel",
    "findingDelta",
    "outcome",
    "createdAt",
    "executionAllowed",
    "executionPerformed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "reportId": { "type": "string", "pattern": "^operator-reassessment:[a-z0-9][a-z0-9._:-]*$" },
    "caseRef": { "type": "string", "minLength": 1 },
    "previousRunIndexRef": { "type": "string", "minLength": 1 },
    "newRunIndexRef": { "type": "string", "minLength": 1 },
    "surfaceKind": { "type": "string", "enum": ["github_posture", "mcp_surface", "mcp_discovery", "ai_runtime", "k8s_manifest"] },
    "previousRiskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "newRiskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "riskDelta": { "type": "integer", "minimum": -100, "maximum": 100 },
    "previousRiskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "newRiskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "findingDelta": { "type": "integer" },
    "closedFindingEstimate": { "type": "integer", "minimum": 0 },
    "remainingFindingCount": { "type": "integer", "minimum": 0 },
    "newFindingEstimate": { "type": "integer", "minimum": 0 },
    "outcome": { "type": "string", "enum": ["improved", "unchanged", "regressed", "needs_review"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "executionAllowed": { "type": "boolean", "const": false },
    "executionPerformed": { "type": "boolean", "const": false }
  }
}
