{
  "repo": {
    "full_name": "SocioProphet/SCOPE-D",
    "default_branch": "main",
    "visibility": "private"
  },
  "branchProtection": {
    "required_pull_request_reviews": { "required_approving_review_count": 1 },
    "required_status_checks": { "strict": true, "contexts": ["Validate Contracts"] },
    "enforce_admins": { "enabled": true },
    "allow_force_pushes": { "enabled": false },
    "allow_deletions": { "enabled": false }
  },
  "actionsPermissions": {
    "enabled": true,
    "default_workflow_permissions": "read",
    "allowed_actions": "selected"
  },
  "codeownersPresent": true,
  "securityFeatures": {
    "secretScanning": "disabled",
    "pushProtection": false
  },
  "dependencyReviewEnabled": true,
  "environments": [
    { "name": "production", "requiredReviewers": true }
  ]
}
